# ─── BambooHR API ────────────────────────────────────────────────────────────
# Gateway root. The company domain is inserted per request: {root}/{domain}/v1
BAMBOOHR_API_ROOT=https://api.bamboohr.com/api/gateway.php

# HTTP Basic-auth password (fixed). BambooHR uses the API key as the username.
BAMBOOHR_BASIC_PASSWORD=mspbots

# Header names carrying credentials in gateway mode (both required per request).
#   DOMAIN_HEADER  -> BambooHR company subdomain (path segment)
#   API_KEY_HEADER -> BambooHR API key (Basic-auth username)
DOMAIN_HEADER=domain
API_KEY_HEADER=api-key

# ─── Credentials (env mode only) ─────────────────────────────────────────────
# Used only when AUTH_MODE=env (local dev). Leave blank in gateway mode —
# credentials are provided per-request via the headers above. NEVER commit real values.
BAMBOOHR_DOMAIN=
BAMBOOHR_API_KEY=

# ─── MCP Transport ───────────────────────────────────────────────────────────
# "http"  — stateless HTTP server (required for production / multi-tenant use)
# "stdio" — local stdio transport (useful for development / CLI use)
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
# "gateway" — (default, SOP-compliant) credentials provided per-request via the
#             DOMAIN_HEADER / API_KEY_HEADER HTTP headers. Both are required.
# "env"     — (local dev only) shared credentials from BAMBOOHR_DOMAIN / BAMBOOHR_API_KEY.
#             NOT SOP-compliant: shared across all requests; do not use in production.
AUTH_MODE=gateway
